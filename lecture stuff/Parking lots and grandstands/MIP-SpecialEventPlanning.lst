---- ObjectiveFunct  =E=  total cost of everything

ObjectiveFunct..  - 1000*I(PurpleRain) - 1500*I(BlueSky) - 200*G(PurpleRain) - 300*G(BlueSky) - 200*X(north) - 250*X(south) - 350*X(west) + TCOST =E= 0 ; (LHS = 0)
     

---- MaxCap  =L=  max capacity in each lot

MaxCap(north)..  50*X(north) =L= 600 ; (LHS = 0)
     
MaxCap(south)..  50*X(south) =L= 500 ; (LHS = 0)
     
MaxCap(west)..  50*X(west) =L= 600 ; (LHS = 0)
     

---- TotalDemandCap  =G=  meet total attendee capacity

TotalDemandCap..  50*X(north) + 50*X(south) + 50*X(west) =G= 1200 ; (LHS = 0, INFES = 1200 ****)
     

---- GrandSeatsCap  =G=  meet capacity for grandstand seats

GrandSeatsCap..  100*G(PurpleRain) + 200*G(BlueSky) =G= 1200 ; (LHS = 0, INFES = 1200 ****)
     

---- AvgTravel  =L=  average travel time from lots

AvgTravel..  7*X(north) - X(south) - 5*X(west) =L= 0 ; (LHS = 0)
     

---- VendorMax  =L=  relationship between grandstands and vendor

VendorMax(PurpleRain)..  - 12*I(PurpleRain) + G(PurpleRain) =L= 0 ; (LHS = 0)
     
VendorMax(BlueSky)..  - 6*I(BlueSky) + G(BlueSky) =L= 0 ; (LHS = 0)
     

---- VendorMin  =G=  min requirment for grandstands if vendor is selected

VendorMin(PurpleRain)..  - I(PurpleRain) + G(PurpleRain) =G= 0 ; (LHS = 0)
     
VendorMin(BlueSky)..  - I(BlueSky) + G(BlueSky) =G= 0 ; (LHS = 0)
     
