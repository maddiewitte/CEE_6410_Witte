Equation Listing    SOLVE HW5Reservoir Using MIP From line 90


---- ObjectiveFunct  =E=  sum of all operating costs and returns

ObjectiveFunct..  20*X(riverpump,season1) + 20*X(riverpump,season2) - 300*A(area) + TCOST + 6000*I(lowdam) + 10000*I(highdam) + 8000*I(riverpump) =E= 0 ; (LHS = 0)
     

---- WaterDemand  =G=  how much water needed to irrigate

WaterDemand(season1)..  X(lowdam,season1) + X(highdam,season1) + X(riverpump,season1) - A(area) =G= 0 ; (LHS = 0)
     
WaterDemand(season2)..  X(lowdam,season2) + X(highdam,season2) + X(riverpump,season2) - 3*A(area) =G= 0 ; (LHS = 0)
     

---- SourceUse  =L=  where the water is going from the reservoir

SourceUse(lowdam,season1)..  X(lowdam,season1) - 300*I(lowdam) =L= 0 ; (LHS = 0)
     
SourceUse(lowdam,season2)..  X(lowdam,season2) - 300*I(lowdam) =L= 0 ; (LHS = 0)
     
SourceUse(highdam,season1)..  X(highdam,season1) - 700*I(highdam) =L= 0 ; (LHS = 0)
     
REMAINING 3 ENTRIES SKIPPED


---- PumpCapacity  =L=  max amount of water the pump can deliver

PumpCapacity(season1)..  X(riverpump,season1) - 401.5*I(riverpump) =L= 0 ; (LHS = 0)
     
PumpCapacity(season2)..  X(riverpump,season2) - 401.5*I(riverpump) =L= 0 ; (LHS = 0)
     

---- PumpWaterAvailability  =L=  how much water the pump has available to pump

PumpWaterAvailability(season1)..  X(riverpump,season1) - Spill(season1) =L= 365 ; (LHS = 0)
     
PumpWaterAvailability(season2)..  X(riverpump,season2) - Spill(season2) =L= 365 ; (LHS = 0)
     

---- StorageS1  =E=  water balance for season 1

StorageS1..  X(lowdam,season1) + X(highdam,season1) + S(season1) + Spill(season1) =E= 600 ; (LHS = 0, INFES = 600 ****)
     

---- StorageS2  =E=  water balance for season 2

StorageS2..  X(lowdam,season2) + X(highdam,season2) - S(season1) + S(season2) + Spill(season2) =E= 200 ; (LHS = 0, INFES = 200 ****)
     

---- DamCapacity  =L=  how much water each dam can store

DamCapacity(season1)..  S(season1) - 300*I(lowdam) - 700*I(highdam) =L= 0 ; (LHS = 0)
     
DamCapacity(season2)..  S(season2) - 300*I(lowdam) - 700*I(highdam) =L= 0 ; (LHS = 0)
     

---- SpillLimit  =L=  how much water the dam needs to spill to the river

SpillLimit(season1)..  - S(season1) + Spill(season1) =L= 600 ; (LHS = 0)
     
SpillLimit(season2)..  - S(season2) + Spill(season2) =L= 200 ; (LHS = 0)
     

---- HighorLowDam  =L=  which dam (high or low) will be built

HighorLowDam..  I(lowdam) + I(highdam) =L= 1 ; (LHS = 0)
     
